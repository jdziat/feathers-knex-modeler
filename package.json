{
  "name": "feathers-knex-modeler",
  "version": "1.5.1",
  "description": "This package allows you to easily extend a table while you are developing it without requiring you to drop tables.",
  "main": "src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "require": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src/index.js",
    "src/index.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "lint": "standard",
    "test:unit": "mocha test/unit --recursive --timeout 5000",
    "test:integration": "mocha test/integration --recursive --timeout 30000",
    "test": "npm run lint && npm run test:unit",
    "test:all": "npm run lint && npm run test:unit && npm run test:integration",
    "coverage": "c8 --reporter=text --reporter=lcov npm run test:unit"
  },
  "keywords": [
    "knex",
    "postgres",
    "schema",
    "migration",
    "idempotent",
    "feathers",
    "table"
  ],
  "author": "Jordan Dziat <jordan@dziat.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdziat/feathers-knex-modeler.git"
  },
  "bugs": {
    "url": "https://github.com/jdziat/feathers-knex-modeler/issues"
  },
  "homepage": "https://github.com/jdziat/feathers-knex-modeler#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "debug": "^4.1.1",
    "p-wait-for": "^3.1.0"
  },
  "devDependencies": {
    "c8": "^11.0.0",
    "chai": "^4.5.0",
    "knex": "^3.2.10",
    "mocha": "^11.7.6",
    "pg": "^8.16.3",
    "standard": "^17.1.2"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^9.0.0"
  }
}
