# Resolve the docs-site dependencies from public npm.
# npm scopes "project" config to the nearest .npmrc to the working directory, so
# the docs subproject needs its own pin (the repo-root .npmrc does not apply when
# npm runs inside website/). Without this, installs fall through to a private
# mirror configured in the user ~/.npmrc and CI cannot authenticate.
registry=https://registry.npmjs.org/
